{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "host", "lane_scores", "total", "verdict", "critical_failures", "activation_verified", "evidence", "grader"],
  "properties": {
    "case_id": {"type": "string"},
    "host": {"enum": ["codex", "claude-code"]},
    "lane_scores": {
      "type": "object",
      "required": ["activation_routing", "production_usability", "task_completeness", "evidence_discipline", "language_scope"],
      "properties": {
        "activation_routing": {"type": "integer", "minimum": 0, "maximum": 10},
        "production_usability": {"type": "integer", "minimum": 0, "maximum": 25},
        "task_completeness": {"type": "integer", "minimum": 0, "maximum": 35},
        "evidence_discipline": {"type": "integer", "minimum": 0, "maximum": 20},
        "language_scope": {"type": "integer", "minimum": 0, "maximum": 10}
      },
      "additionalProperties": false
    },
    "total": {"type": "integer", "minimum": 0, "maximum": 100},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "critical_failures": {"type": "array", "items": {"type": "string"}},
    "activation_verified": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rationale": {"type": "string"},
    "activation_evidence": {"type": "string"},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "grader": {
      "type": "object",
      "required": ["role", "model", "effort", "independent"],
      "properties": {
        "role": {"type": "string"},
        "model": {"type": "string"},
        "effort": {"type": "string"},
        "independent": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
